HOST=127.0.0.1
PORT=4318
ALLOWED_HOSTS=127.0.0.1,localhost,::1
DATA_FILE=var/state.json
PUBLIC_WEBSITE=1
ENABLE_MEDIA_RENDER=false

# Keep credentials in the environment of your deployment.
# A non-loopback deployment requires an HTTPS PUBLIC_ORIGIN, matching
# ALLOWED_HOSTS and a valid ADMIN_PASSWORD_HASH.
PUBLIC_ORIGIN=
ADMIN_PASSWORD_HASH=
ADMIN_AGENT_TOKEN_HASH=

LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
GITHUB_REPOSITORY=
GITHUB_TOKEN=
GEO_ENGINE_DB=

# Optional native video tools use a separate owner-only data directory.
PENGMANAGER_VIDEO_DATA_DIR=
WORKLOOM_PM_ORIGIN=
